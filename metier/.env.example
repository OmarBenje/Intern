# Développement local. `uv run --env-file .env app/manage.py ...` charge ce fichier.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=intern
POSTGRES_USER=intern_user
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
PUBLIC_BASE_URL=http://localhost:8000
PRIVATE_STORAGE_BACKEND=local
# Production: DEBUG=false, a generated DJANGO_SECRET_KEY, strong DB password,
# explicit hosts, HTTPS URL, external private R2, configured email backend.
# DJANGO_SECRET_KEY=
# For an EU-jurisdiction bucket, use https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# GREENHOUSE_API_KEYS={"authorized-board-token":"partner-job-board-api-key"}
