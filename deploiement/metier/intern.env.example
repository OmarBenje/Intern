# Démonstration locale en HTTP. Les secrets réels restent hors du dépôt.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=@DJANGO_SECRET_KEY@
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.10.10.10,10.10.10.20
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
POSTGRES_DB=intern
POSTGRES_USER=intern_user
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_HOST=10.10.10.30
POSTGRES_PORT=5432
INTERN_ROOT=/opt/intern
PRIVATE_STORAGE_BACKEND=local
PRIVATE_STORAGE_ROOT=/var/lib/intern/private-media
MAIL_BACKEND=django.core.mail.backends.console.EmailBackend
GREENHOUSE_API_KEYS={}
